# Copy to .env (git-ignored) and fill in. Never put real credentials in this file.
#
# Supabase Postgres for the trusted server only (never the browser).
# Supabase → Connect → Session pooler (port 5432) for the long-running Node server;
# use the Transaction pooler (port 6543) only for serverless hosts.
# URL-encode reserved characters in the password (e.g. # -> %23, @ -> %40).
# Leave DATABASE_URL unset to use local SQLite instead.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
