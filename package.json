{
  "name": "ducktown-local",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "npm run build:frontend",
    "start": "node server/app.js",
    "dev:frontend": "vite --config frontend/vite.config.js",
    "build:frontend": "vite build --config frontend/vite.config.js",
    "preview:frontend": "vite preview --config frontend/vite.config.js",
    "test": "node --test server/*.test.js frontend/src/robot-motion.test.js frontend/src/microduck-kinematics.test.js frontend/src/exact-duck.test.js",
    "test:live": "node --test server/live-sdk.test.js",
    "test:browser": "npm run build:frontend && playwright test",
    "demo:rehearse": "npm run build:frontend && playwright test e2e/presentation.spec.js",
    "backup:db": "node server/backup-db.js",
    "rehearse:restore": "node server/rehearse-restore.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "three": "^0.180.0",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "motion": "^13.4.4"
  }
}
